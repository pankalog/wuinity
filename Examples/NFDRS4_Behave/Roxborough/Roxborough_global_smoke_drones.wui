[Simulation]
Name=Roxborough_global_smoke_drones_aco
LowerLeftLatLon=39.409924,-105.104505
DomainSize=10000.0,11000.0
DeltaTime=1.0
StartDateTime=2001-06-05T11:00:00
EndDateTime=2001-06-07T11:00:00
StopWhenEvacuated=true

[Map]
MapProvider=Mapbox
ZoomLevel=13

[Weather]
WeatherFile=roxborough_weather.csv

[Population]
PopulationFile=population/big_population.csv
CullOutsideGroups=true

[Demographics]
Name=one_car
Default=true
AllowMoreThanOneCar=false
MaxCars=1
MaxCarsProbability=0.3

[Evacuation]
EvacuationOrderStart=4000
UseTriggerBufferEvacuation=false
TriggerBufferFile=fire/trigger_buffer.asc

[Destination]
Name=goal_highway
LatLon=39.5071781907873, -105.02231033756013
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,1.0,1.0

[Destination]
Name=goalE
LatLon=39.427991, -105.073289
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=1.0,0.0,0.0

[Destination]
Name=goalF
LatLon=39.466157, -105.082197
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=.0,1.0,0.0

[Destination]
Name=goalR
LatLon=39.473858, -105.092137
Type=Exit
MaxFlow=-1.0
MaxVehicles=-1
MaxPeople=-1
Blocked=false
Color=0.0,0.0,1.0

[ResponseCurve]
Name=observed_average
TimeInput=Relative
0, 0
300, 0.037
1080, 0.67
1860, 0.76
1980, 0.85
6300, 1.0

[ResponseCurve]
Name=reported_average
TimeInput=Relative
0, 0
900, 0.79
1800, 0.91
2700, 0.93
3600, 0.97
5400, 1.0

[EvacuationGroup]
EvacuationOrderDateTime=2001-06-05T11:30:00
Name=groupA
Demographics=one_car
DestinationChoice=EvacGroupCDF
ShapeFile=groups/groupA.shp
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Destinations=goalE, goalR, goalF
DestinationsCDF=0.4,0.7,1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
EvacuationOrderDateTime=2001-06-05T11:30:00
Name=groupB
Demographics=one_car
ShapeFile=groups/groupB.shp
DestinationChoice=EvacGroupCDF
Destinations=goalE, goalR, goalF
DestinationsCDF=0.25, 0.75, 1.0
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Color=1.0,1.0,0.0

[EvacuationGroup]
EvacuationOrderDateTime=2001-06-05T11:30:00
Name=groupC
Demographics=one_car
ShapeFile=groups/groupC.shp
DestinationChoice=EvacGroupCDF
Destinations=goalE, goalR, goalF
DestinationsCDF=0.1, 0.2, 1.0
ResponseCurves=observed_average 
ResponseCurvesCDF=1.0
Color=0.0,1.0,0.0

[PedestrianModule]
Enabled=true
Module=MacroHouseholdSim

[MacroHouseholdSim]
WalkingSpeedMinMax=0.7,1.0
WalkingSpeedModifier=1.0
WalkingDistanceModifier=1.0

[TrafficModule]
Enabled=true
Module=SUMO
VisibilityAffectsSpeed=false

[SUMO]
ConfigurationFile=sumo/rox_density.sumocfg
UTMoffset=-491253.49,-4359238.56
SmokeAlpha=0.4967
SmokeBeta=-0.02910

[DroneModule]
Enabled=true
Module=SwarmScaffold
EnableTelemetryOutput=true
TelemetryIntervalSeconds=1.0
TelemetryIncludeEdgePheromones=true

[DroneFleet]
DroneCount=50
CruiseSpeedMps=15.0
BatteryEnduranceSeconds=480000000.0
ReturnReserveFraction=0.10
RechargeDurationSeconds=1200.0
AutoPlaceChargingStationBottomLeft=true
ChargingStationSimulationPos=0.0,0.0
UniformTypeId=default
RandomSpawnAcrossNetwork=false
RandomSpawnSeed=42

; [DronePolicy]
; RoutingPolicy=AcoStigmergic
; TreatEdgesAsUndirected=true
; MarkScannedOnFullTraversal=true
; AllowOffRoadTransit=true
; AllowEdgeOverlap=true
; DiagnosticsIntervalSeconds=10.0
; StalenessWeight=1.0
; VehicleDensityWeight=0.0
; EdgeMergeToleranceMeters=10.0
; MinComponentEdges=1

[DronePolicy]
RoutingPolicy=Raster
TreatEdgesAsUndirected=true
MarkScannedOnFullTraversal=true
AllowOffRoadTransit=true
AllowEdgeOverlap=true
DiagnosticsIntervalSeconds=10.0
StalenessWeight=1.0
VehicleDensityWeight=0.0


; [AcsPolicy]
; Alpha=1.0
; Beta=2.0
; EvaporationRate=0.2
; OneAntPerDrone=true
; NextEdgeOnly=true
; AgeUpAndResetOnScan=true
; HeuristicMode=PureDistance

[RasterPolicy]
UseDroneOwnedGrid=true
PreferRoadIntersectingCells=true
CellSizeMeters=250.0

[AcoStigmergicPolicy]
; --- Decay rates ---
RhoS=0.01
RhoV=0.001
RhoC=0.005
; --- Deposit magnitudes ---
Qs=10.0
Qv=10.0
Qc=60.0
; --- Decision exponents ---
Alpha=1.5
Beta=2.3
Delta=5.0
; --- Pheromone Diffusion ---
DiffusionV=0.1
DiffusionStepSeconds=1.0


UseBidiAggregation=true
GammaSourceFile=sumo/reference_edge_density.xml
DefaultGamma=1.0
UseReferenceWeightsOnline=true

[WildfireModule]
Enabled=true
Module=AscImport
GraphicalFireInputFile=fire/example.gfi

[AscImport]
StartDateTime=2001-06-05T11:00:00
TimeOfArrivalFile=flammap/output/TOA.asc
RateOfSpreadFile=flammap/output/ROS.asc
SpreadDirectionFile=flammap/output/SD.asc
FirelineIntensityFile=flammap/output/FI.asc

[TriggerBufferModule]
Enabled=false
Module=kPERIL

[kPERIL]
MidflameWindspeed=10.0
CalculateROSFromBehave=true
InitialFuelMoistureFile=fireCell/default.fmc
OutputName=trigger_buffer.asc

[WUIShow]
SendDataToWUIShow=false
WuiShowServerIP=127.0.0.1
WuiShowServerPort=9023
WuiShowDeltaTime=1.0

[SmokeModule]
Enabled=true
Module=GlobalSmoke

[GlobalSmoke]
ExtinctionFile=globalSmoke/extCoeffRamp.exc
