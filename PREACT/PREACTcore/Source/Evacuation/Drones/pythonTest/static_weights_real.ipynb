{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Static Edge Weights — Real Roxborough WUI Scenario\n",
    "\n",
    "Uses the actual WUI-NITY scenario file `Roxborough_global_smoke_drones.wui`:\n",
    "- **4 real exits** (`goal_highway`, `goalE`, `goalF`, `goalR`) with lat/lon\n",
    "- **5119 households** from `population/big_population.csv`, each with an origin + access point + occupants\n",
    "- **Demographics** (1 car / household from the .wui file)\n",
    "\n",
    "Lat/lon is reprojected to UTM zone 13N and shifted by the SUMO `netOffset` to\n",
    "match the network-local coordinate system, then each household's access point\n",
    "is snapped to the nearest SUMO node."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.colors as mcolors\n",
    "import numpy as np\n",
    "\n",
    "from metrics import (\n",
    "    load_sumo_network, build_graphs,\n",
    "    annotate_capacity,\n",
    "    assign_static_demand, assign_static_demand_by_exit, compute_f_demand,\n",
    "    compute_f_topo, compute_f_redundancy,\n",
    "    combine_weights,\n",
    "    load_scenario,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "NET_FILE = \"../../../../../../Examples/NFDRS4_Behave/Roxborough/sumo/rox_big.net.xml\"\n",
    "WUI_FILE = \"../../../../../../Examples/NFDRS4_Behave/Roxborough/Roxborough_global_smoke_drones.wui\"\n",
    "\n",
    "sumo_net = load_sumo_network(NET_FILE)\n",
    "DG, UG = build_graphs(sumo_net)\n",
    "annotate_capacity(DG); annotate_capacity(UG)\n",
    "print(f\"Network: {DG.number_of_nodes()} nodes, {DG.number_of_edges()} directed edges\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load the WUI scenario"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "scen = load_scenario(WUI_FILE, DG)\n",
    "\n",
    "print(f\"Households (raw):         {scen['total_households_raw']}\")\n",
    "print(f\"Households (post-cull):   {scen['total_households']}\")\n",
    "print(f\"Culled households:        {scen['culled_households']}\")\n",
    "print(f\"Cars/household:           {scen['cars_per_household']}\")\n",
    "print(f\"Total vehicles (post-cull): {scen['total_vehicles']:.0f}\")\n",
    "print(f\"Group counts:             {scen['group_counts']}\")\n",
    "print(f\"\\nExits (snapped to nearest SUMO node):\")\n",
    "for name, node_id, dist in scen['exits']:\n",
    "    print(f\"  {name:<14} -> node {node_id}  ({dist:.1f} m from exit coord)\")\n",
    "\n",
    "print(f\"\\nUnique origin nodes (after snap): {len(scen['origins'])}\")\n",
    "print(f\"Max vehicles at a single origin node: {max(scen['origins'].values()):.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def pos_of(G):\n",
    "    return {n: (G.nodes[n]['x'], G.nodes[n]['y']) for n in G.nodes()}\n",
    "\n",
    "# Plot the scenario: origins weighted by vehicle count, exits highlighted\n",
    "fig, ax = plt.subplots(figsize=(13, 13))\n",
    "pos = pos_of(UG)\n",
    "\n",
    "nx.draw_networkx_edges(UG, pos, ax=ax, edge_color='lightgray', width=0.6)\n",
    "\n",
    "origin_nodes = list(scen['origins'].keys())\n",
    "origin_sizes = [3 + 2 * scen['origins'][n] for n in origin_nodes]\n",
    "nx.draw_networkx_nodes(UG, pos, nodelist=origin_nodes, ax=ax,\n",
    "                       node_size=origin_sizes, node_color='steelblue', alpha=0.55,\n",
    "                       label=f'Origins ({len(origin_nodes)}), size = vehicles')\n",
    "\n",
    "exit_nodes = [e[1] for e in scen['exits']]\n",
    "nx.draw_networkx_nodes(UG, pos, nodelist=exit_nodes, ax=ax,\n",
    "                       node_size=350, node_color='red', edgecolors='black',\n",
    "                       linewidths=2, label=f'Exits ({len(exit_nodes)})')\n",
    "for name, node_id, _ in scen['exits']:\n",
    "    x, y = pos[node_id]\n",
    "    ax.text(x, y + 150, name, fontsize=10, ha='center',\n",
    "            bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n",
    "\n",
    "ax.legend(fontsize=11, loc='upper left')\n",
    "ax.set_title(f\"Roxborough WUI scenario — {scen['total_vehicles']:.0f} vehicles across {len(origin_nodes)} origin nodes, 4 exits\")\n",
    "ax.set_aspect('equal'); ax.axis('off')\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Compute the three components"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EVAC_HOURS = 1.0  # Short departure window to reflect imminent-threat evacuation\n",
    "\n",
    "if scen['origin_exit_vehicles']:\n",
    "    volumes, unassigned = assign_static_demand_by_exit(DG, scen['origin_exit_vehicles'])\n",
    "    print('Demand model: WUI EvacGroup destination CDF (origin->exit split)')\n",
    "else:\n",
    "    volumes, unassigned = assign_static_demand(DG, scen['origins'], exit_nodes)\n",
    "    print('Demand model: nearest-exit all-or-nothing')\n",
    "\n",
    "f_demand = compute_f_demand(DG, volumes, evacuation_duration_hours=EVAC_HOURS)\n",
    "\n",
    "print(f\"Unassigned OD tuples (no path): {len(unassigned)}\")\n",
    "print(f\"Loaded directed edges: {len(volumes)} / {DG.number_of_edges()}\")\n",
    "print(f\"Peak edge volume: {max(volumes.values()):.0f} vehicles\")\n",
    "\n",
    "v = np.array(list(f_demand.values()))\n",
    "print(f\"\\nf_demand over all edges:\")\n",
    "print(f\"  mean={v.mean():.3f}  max={v.max():.3f}\")\n",
    "print(f\"  edges saturated (f_demand >= 1.0): {(v>=1.0).sum()}\")\n",
    "print(f\"  edges > 50% loaded:                {(v>0.5).sum()}\")\n",
    "print(f\"  edges > 10% loaded:                {(v>0.1).sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "f_topo = compute_f_topo(UG, scen['origins'], exit_nodes, weight='travel_time')\n",
    "f_redundancy = compute_f_redundancy(UG)\n",
    "\n",
    "# Fold directed f_demand onto undirected edges (take max of both directions)\n",
    "f_demand_ug = {}\n",
    "for u, v in UG.edges():\n",
    "    f_demand_ug[(u, v)] = max(f_demand.get((u, v), 0.0),\n",
    "                               f_demand.get((v, u), 0.0))\n",
    "\n",
    "print(f\"f_topo max: {max(f_topo.values()):.3f}\")\n",
    "n_bridges = sum(1 for v in f_redundancy.values() if v == 1.0)\n",
    "print(f\"Bridges: {n_bridges} / {UG.number_of_edges()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def draw_edge_values(G, values, title, cmap='viridis', ax=None,\n",
    "                     vmin=None, vmax=None, width_scale=1.6, log_scale=False):\n",
    "    if ax is None:\n",
    "        fig, ax = plt.subplots(figsize=(13, 13))\n",
    "    pos = pos_of(G)\n",
    "    edges = list(G.edges())\n",
    "    vals = []\n",
    "    for u, v in edges:\n",
    "        if (u, v) in values:\n",
    "            vals.append(values[(u, v)])\n",
    "        elif (v, u) in values:\n",
    "            vals.append(values[(v, u)])\n",
    "        else:\n",
    "            vals.append(0.0)\n",
    "    vals = np.array(vals)\n",
    "    if log_scale:\n",
    "        vals_display = np.log1p(vals)\n",
    "    else:\n",
    "        vals_display = vals\n",
    "    vmin = vals_display.min() if vmin is None else vmin\n",
    "    vmax = vals_display.max() if vmax is None else vmax\n",
    "    if vmax == vmin:\n",
    "        vmax = vmin + 1e-9\n",
    "    widths = 0.4 + width_scale * (vals_display - vmin) / (vmax - vmin)\n",
    "    cmap_obj = plt.cm.get_cmap(cmap)\n",
    "    colors = cmap_obj((vals_display - vmin) / (vmax - vmin))\n",
    "    nx.draw_networkx_edges(G, pos, edgelist=edges, ax=ax,\n",
    "                           edge_color=colors, width=widths)\n",
    "    nx.draw_networkx_nodes(G, pos, ax=ax, node_size=1, node_color='black', alpha=0.3)\n",
    "    sm = plt.cm.ScalarMappable(cmap=cmap_obj, norm=mcolors.Normalize(vmin=vmin, vmax=vmax))\n",
    "    sm.set_array([])\n",
    "    plt.colorbar(sm, ax=ax, shrink=0.6, label=title)\n",
    "    ax.set_title(title, fontsize=14)\n",
    "    ax.set_aspect('equal'); ax.axis('off')\n",
    "    return ax"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Visualize the three components and overlay exits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def overlay_exits(ax):\n",
    "    pos = pos_of(UG)\n",
    "    for name, node_id, _ in scen['exits']:\n",
    "        x, y = pos[node_id]\n",
    "        ax.scatter([x], [y], s=150, c='red', edgecolors='black',\n",
    "                   linewidths=1.5, zorder=5)\n",
    "        ax.text(x, y + 200, name, fontsize=9, ha='center', zorder=6,\n",
    "                bbox=dict(boxstyle='round', facecolor='white', alpha=0.85))\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(22, 22))\n",
    "\n",
    "draw_edge_values(UG, f_demand_ug, 'f_demand = V_e / q_c  (LOS ratio, 1h evac)',\n",
    "                 cmap='YlOrRd', ax=axes[0, 0], vmin=0, vmax=1)\n",
    "overlay_exits(axes[0, 0])\n",
    "\n",
    "# f_topo tends to be very peaky — log-scaled colormap reveals mid-tier edges\n",
    "draw_edge_values(UG, f_topo, 'f_topo  (evacuation betweenness, log scale)',\n",
    "                 cmap='viridis', ax=axes[0, 1], log_scale=True)\n",
    "overlay_exits(axes[0, 1])\n",
    "\n",
    "draw_edge_values(UG, f_redundancy, 'f_redundancy = 1 / kappa  (bridges = 1.0)',\n",
    "                 cmap='Reds', ax=axes[1, 0], vmin=0.5, vmax=1)\n",
    "overlay_exits(axes[1, 0])\n",
    "\n",
    "# Combined\n",
    "W = combine_weights(list(UG.edges()), f_demand_ug, f_topo, f_redundancy,\n",
    "                    w_demand=0.5, w_topo=0.3, w_redundancy=0.2)\n",
    "w_arr = np.array(list(W.values()))\n",
    "draw_edge_values(UG, W, f'Combined W (0.5/0.3/0.2)  — max {w_arr.max():.2f}',\n",
    "                 cmap='inferno', ax=axes[1, 1], vmin=0, vmax=w_arr.max())\n",
    "overlay_exits(axes[1, 1])\n",
    "\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Where does the network actually fail?\n",
    "\n",
    "List every edge saturated under the 1-hour evacuation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "saturated = [(e, f_demand_ug[e]) for e in UG.edges() if f_demand_ug[e] >= 1.0]\n",
    "saturated.sort(key=lambda kv: -kv[1])\n",
    "print(f\"{'edge':<35} {'f_dem':>6} {'q_c (veh/h)':>12} {'road type':<25}\")\n",
    "print('-' * 85)\n",
    "for (u, v), fd in saturated:\n",
    "    data = UG[u][v]\n",
    "    print(f\"{u[:15]:<15}-> {v[:15]:<15}  {fd:>6.2f}  {data['q_c_edge_per_hour']:>12.0f}  {data.get('edge_type','?')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Compare: peak-hour flow vs capacity, by road type\n",
    "\n",
    "Shows which road classes the evacuation actually pushes past their service\n",
    "volume — i.e., where drone monitoring adds the most information."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import defaultdict\n",
    "by_type = defaultdict(list)\n",
    "for u, v in UG.edges():\n",
    "    t = UG[u][v].get('edge_type', 'unknown')\n",
    "    by_type[t].append(f_demand_ug[(u, v)])\n",
    "\n",
    "print(f\"{'road type':<30} {'#edges':>7} {'mean f_d':>10} {'max f_d':>10} {'#saturated':>12}\")\n",
    "print('-' * 75)\n",
    "for t in sorted(by_type.keys()):\n",
    "    vals = np.array(by_type[t])\n",
    "    print(f\"{t:<30} {len(vals):>7} {vals.mean():>10.3f} {vals.max():>10.3f} {(vals>=1.0).sum():>12}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Drone-priority map: top 5% of edges by combined weight"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "thresh = np.percentile(w_arr, 95)\n",
    "priority_edges = [e for e, w in W.items() if w >= thresh]\n",
    "print(f\"Top-5% threshold: W >= {thresh:.3f}\")\n",
    "print(f\"Priority edges: {len(priority_edges)}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 14))\n",
    "pos = pos_of(UG)\n",
    "nx.draw_networkx_edges(UG, pos, ax=ax, edge_color='lightgray', width=0.5)\n",
    "nx.draw_networkx_edges(UG, pos, edgelist=priority_edges, ax=ax,\n",
    "                       edge_color='crimson', width=2.5)\n",
    "overlay_exits(ax)\n",
    "ax.set_title(f'Top 5% drone-priority edges ({len(priority_edges)} of {UG.number_of_edges()}) — red')\n",
    "ax.set_aspect('equal'); ax.axis('off')\n",
    "plt.tight_layout(); plt.show()"
   ]
  }
 ],
